{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-mail-intake",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-18",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mail.example.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Retention has to hold for idle domains too, so the sweep cannot be driven by
  // inbound mail alone. This is what makes RETENTION_HOURS an actual guarantee.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Caps /admin/* before the token is checked, which is what bounds token guessing.
  // Remove this block and the Worker still runs; the limiter is optional by design.
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMIT",
      // Any positive integer unique within your Cloudflare account.
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "MAX_RAW_BYTES": "1048576",
    "RETENTION_HOURS": "6"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-mail-intake",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
