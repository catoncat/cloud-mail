{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-mail-intake",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-18",
  // No public URL: share reaches this Worker through its Service Binding.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Retention has to hold for idle domains too, so the sweep cannot be driven by
  // inbound mail alone. This is what makes RETENTION_HOURS an actual guarantee.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "MAX_RAW_BYTES": "1048576",
    "RETENTION_HOURS": "6"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-mail-intake",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
